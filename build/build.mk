# ============================================================
#  编译工具
# ============================================================

CC := gcc
AR := ar

CFLAGS := -Wall -Wextra -g -O2 -fPIC -D_GNU_SOURCE

# ============================================================
# 自动获取工程根目录（关键）
# ============================================================

ROOT_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))..)

# ============================================================
# include路径统一
# ============================================================

INCLUDES := -I$(ROOT_DIR)/src

# ============================================================
# 通用对象规则
# ============================================================

OBJ := $(SRC:.c=.o)

all: $(LIB)

$(LIB): $(OBJ)
	$(AR) rcs $@ $^

%.o: %.c
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

clean:
	rm -f $(OBJ) $(LIB)

print:
	@echo "ROOT_DIR=$(ROOT_DIR)"
	@echo "MODULE=$(MODULE)"
	@echo "SRC=$(SRC)"
	@echo "OBJ=$(OBJ)"